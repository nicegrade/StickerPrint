{
  "manifest_version": 3,
  "name": "StickerPrint",
  "version": "5.6",
  "description": "Автоматическая печать ячеек Turbo-PVZ",

  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://turbo-pvz.ozon.ru/*",
    "http://127.0.0.1:3000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://turbo-pvz.ozon.ru/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://turbo-pvz.ozon.ru/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },

  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}